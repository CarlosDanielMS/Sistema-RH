# ─── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rh_user:rh_pass@postgres:5432/rh_ia

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/curriculos
MAX_CV_SIZE_MB=10

# ─── Thresholds de triagem ────────────────────────────────────────────────────
SCORE_APROVADO=80
SCORE_PENDENTE=50

# ─── Empresa ──────────────────────────────────────────────────────────────────
EMPRESA_NOME=Minha Empresa

# ─── Marketing / E-mail (SMTP) ────────────────────────────────────────────────
# Gmail: smtp.gmail.com:587  |  Outlook: smtp.office365.com:587
# Para Gmail use Senha de App: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_TLS=true

# ─── WhatsApp via n8n (opcional) ──────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678

# ─── n8n painel ───────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=admin123

# ─── Frontend (usado pelo docker-compose) ─────────────────────────────────────
VITE_API_URL=http://localhost:8000
